<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
         Title="Вход в систему" 
        Height="720" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" Text="Каршеринг" 
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,15,0,20"/>

        <TextBlock Grid.Row="1" Text="Логин" Margin="0,0,0,5"/>

        <TextBox x:Name="txtLogin" Grid.Row="2" 
                 Height="30" Margin="0,0,0,15"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="3" Text="Пароль" Margin="0,0,0,5"/>

        <PasswordBox x:Name="txtPassword" Grid.Row="4" 
                     Height="30" Margin="0,0,0,20"/>
        <Border Grid.Row="5"
                BorderBrush="AliceBlue"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,10"
                Background="White">


            <StackPanel Grid.Row="6">

                <TextBlock Text="Соберите пазл:" 
                   FontWeight="Bold" Margin="0,5,0,8"/>

                <UniformGrid Name ="PuzzleGrid" Rows="2" Columns="2" Margin="10"/>
            </StackPanel>
        </Border>
        <Button x:Name="btnLogin" Grid.Row="7" Content="Войти"
                Height="35" Width="100" HorizontalAlignment="Center"
                Background="#1A73E8" Foreground="White" FontWeight="Bold"
                Click="btnLogin_Click" VerticalAlignment="Center"/>

    </Grid>
</Window>