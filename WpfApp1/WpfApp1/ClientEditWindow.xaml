<Window x:Class="WpfApp1.ClientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Клиент" Height="380" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" 
                   VerticalAlignment="Center" Margin="0,8"/>
        <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" 
                 Height="28" Margin="0,5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="ИНН:" 
                   VerticalAlignment="Center" Margin="0,8"/>
        <TextBox x:Name="txtInn" Grid.Row="1" Grid.Column="1" 
                 Height="28" Margin="0,5" MaxLength="12"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес:" 
                   VerticalAlignment="Center" Margin="0,8"/>
        <TextBox x:Name="txtAddress" Grid.Row="2" Grid.Column="1" 
                 Height="28" Margin="0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Телефон:" 
                   VerticalAlignment="Center" Margin="0,8"/>
        <TextBox x:Name="txtPhone" Grid.Row="3" Grid.Column="1" 
                 Height="28" Margin="0,5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Продавец:" 
                   VerticalAlignment="Center" Margin="0,8"/>
        <CheckBox x:Name="chkSalesman" Grid.Row="4" Grid.Column="1" 
                  VerticalAlignment="Center" Margin="0,8"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Покупатель:" 
                   VerticalAlignment="Center" Margin="0,8"/>
        <CheckBox x:Name="chkBuyer" Grid.Row="5" Grid.Column="1" 
                  VerticalAlignment="Center" Margin="0,8"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Сохранить" Width="100" Height="35"
                    Margin="0,0,10,0" Click="btnSave_Click"/>

            <Button Content="Отмена" Width="80" Height="35"
                    Click="btnCancel_Click"/>

        </StackPanel>

    </Grid>
</Window>